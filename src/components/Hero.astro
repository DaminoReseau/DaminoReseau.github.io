---
---

<section id="hero">
  <div class="hero-content">
    <p class="label">// Administrateur Systèmes & Réseaux</p>
    <h1>
      Damino<br />
      <span class="outline">Reseau</span>
    </h1>
    <p class="desc">
      Infrastructure solide. Réseaux fiables.<br />
      Systèmes sous contrôle — 24/7.
    </p>
    <div class="ctas">
      <a href="#skills" class="btn-primary">Voir mes compétences</a>
      <a href="#contact" class="btn-outline">Me contacter</a>
    </div>
  </div>

  <div class="terminal" aria-hidden="true">
    <div class="t-bar">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
      <span class="t-title">bash — sysadmin@server</span>
    </div>
    <div class="t-body">
      <div class="t-row"><span class="prompt">$</span><span class="cmd">whoami</span></div>
      <div class="t-row out">DaminoReseau</div>
      <div class="t-row"><span class="prompt">$</span><span class="cmd">cat role.txt</span></div>
      <div class="t-row out">Admin Systèmes &amp; Réseaux</div>
      <div class="t-row"><span class="prompt">$</span><span class="cmd">uptime</span></div>
      <div class="t-row out">up 3 years, load avg: 0.02</div>
      <div class="t-row"><span class="prompt">$</span><span class="cmd">ping disponibilite -c1</span></div>
      <div class="t-row out">64 bytes — time=1ms ✓</div>
      <div class="t-row"><span class="prompt">$</span><span class="cursor"></span></div>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .hero-content { flex: 1; }

  .label {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s 0.3s forwards;
  }

  h1 {
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1.8rem;
    opacity: 0;
    animation: fadeUp 0.6s 0.5s forwards;
  }

  .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--muted);
  }

  .desc {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.6s 0.7s forwards;
  }

  .ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.6s 0.9s forwards;
  }

  /* Terminal */
  .terminal {
    width: 380px;
    flex-shrink: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.8rem;
    opacity: 0;
    animation: fadeIn 0.8s 1.1s forwards;
  }

  .t-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.02);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.red    { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green  { background: #28c840; }
  .t-title { margin-left: auto; color: var(--muted); font-size: 0.7rem; }

  .t-body { padding: 1.2rem; line-height: 2.1; }
  .t-row { display: flex; gap: 0.5rem; }
  .prompt { color: var(--accent); }
  .cmd { color: var(--text); }
  .out { color: var(--muted); padding-left: 1.2rem; }

  .cursor {
    display: inline-block;
    width: 8px; height: 14px;
    background: var(--accent);
    animation: blink 1s step-end infinite;
    vertical-align: middle;
  }

  @media (max-width: 900px) {
    #hero { flex-direction: column; justify-content: center; padding-top: 7rem; }
    .terminal { width: 100%; max-width: 420px; }
  }
  @media (max-width: 600px) {
    #hero { padding: 6rem 1.5rem 3rem; }
  }
</style>
