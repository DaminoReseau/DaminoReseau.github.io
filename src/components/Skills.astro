---
const skills = [
  {
    icon: '🖥️',
    category: 'Systèmes',
    name: 'Administration OS',
    tags: ['Linux', 'Windows Server', 'Debian', 'Ubuntu', 'Active Directory'],
  },
  {
    icon: '🌐',
    category: 'Réseaux',
    name: 'Infrastructure Réseau',
    tags: ['TCP/IP', 'VLAN', 'VPN', 'Cisco', 'Firewall', 'DNS / DHCP'],
  },
  {
    icon: '☁️',
    category: 'Cloud & Virt.',
    name: 'Virtualisation',
    tags: ['VMware', 'Proxmox', 'Docker', 'Azure', 'Hyper-V'],
  },
  {
    icon: '🔒',
    category: 'Sécurité',
    name: 'Cybersécurité',
    tags: ['Pare-feu', 'IDS/IPS', 'Hardening', 'Audit', 'SSL/TLS'],
  },
  {
    icon: '📊',
    category: 'Monitoring',
    name: 'Supervision',
    tags: ['Zabbix', 'Grafana', 'Nagios', 'Prometheus', 'SNMP'],
  },
  {
    icon: '⚙️',
    category: 'Automatisation',
    name: 'Scripts & DevOps',
    tags: ['Bash', 'Python', 'Ansible', 'PowerShell', 'Git'],
  },
];
---

<section id="skills">
  <div class="section-header reveal">
    <span class="num">02</span>
    <h2>Compétences</h2>
    <div class="line"></div>
  </div>

  <div class="grid">
    {skills.map((s, i) => (
      <div class="card reveal" style={`transition-delay: ${i * 0.07}s`}>
        <div class="card-icon">{s.icon}</div>
        <div class="card-category">{s.category}</div>
        <div class="card-name">{s.name}</div>
        <div class="tags">
          {s.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  section {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 3rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  .num {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  h2 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .line { flex: 1; height: 1px; background: var(--border); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .card {
    background: var(--surface);
    padding: 2rem;
    transition: background 0.2s;
  }
  .card:hover { background: var(--surface2); }

  .card-icon { font-size: 1.4rem; margin-bottom: 1rem; }

  .card-category {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .card-name {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.2rem;
  }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.25rem 0.6rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .card:hover .tag { color: var(--text); border-color: rgba(255,255,255,0.15); }

  @media (max-width: 900px) {
    section { padding: 5rem 1.5rem; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 500px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
